% Goal state
goal([1,2,3,4,5,6,7,8,0]).

% -------------------------
% Heuristic: Misplaced tiles
% -------------------------
heuristic(State, H) :-
    goal(Goal),
    count_diff(State, Goal, H).

count_diff([], [], 0).

count_diff([0|T1], [_|T2], H) :-
    count_diff(T1, T2, H).

count_diff([X|T1], [X|T2], H) :-
    count_diff(T1, T2, H).

count_diff([_|T1], [_|T2], H) :-
    count_diff(T1, T2, H1),
    H is H1 + 1.

% -------------------------
% Simple Best First Search
% -------------------------

solve(Start, Start) :-
    goal(Start).

solve(Start, Goal) :-
    move(Start, Next),
    solve(Next, Goal).

