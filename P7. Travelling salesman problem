% TSP (simple path + cost)

tsp([Start|Cities], Path, Cost) :-
    append([Start|Cities], [Start], Path),
    calc_cost(Path, Cost).

% calculate total cost
calc_cost([_], 0).

calc_cost([A,B|T], Cost) :-
    dist(A,B,C1),
    calc_cost([B|T], C2),
    Cost is C1 + C2.



% Query  
?- tsp([a,b,c,d], Path, Cost).
