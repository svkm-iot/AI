
% Main predicate
eight_queens(Queens) :-
    Queens = [Q1,Q2,Q3,Q4,Q5,Q6,Q7,Q8],
    permutation([1,2,3,4,5,6,7,8], Queens),
    safe(Queens).

% Check safety of queens
safe([]).

safe([Q|Others]) :-
    safe(Others),
    no_attack(Q, Others, 1).

% No attack condition
no_attack(_, [], _).

no_attack(Q, [Q1|Rest], D) :-
    Q =\= Q1,
    abs(Q - Q1) =\= D,
    D1 is D + 1,
    no_attack(Q, Rest, D1).

% Query 
?- eight_queens(Queens).
